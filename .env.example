# ── Gmail / Google Workspace (sending + reply tracking) ──────────────
# Requires 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@yourcompany.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM_NAME=Your Name

# ── Lead data providers (either one enables real lead search) ────────
# https://apolloio.github.io/apollo-api-docs (Settings → Integrations → API)
APOLLO_API_KEY=
# https://hunter.io/api-keys
HUNTER_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────
# Require a password (HTTP Basic Auth) to open the app — recommended
# for any hosted deployment.
APP_PASSWORD=

# Where to store the SQLite database (default: ./data/outreach.db)
# DATABASE_PATH=

# Seed a handful of demo leads on first run
# SEED_DEMO=1
