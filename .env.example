# ── Profiles / auth ──────────────────────────────────────────────────
# Invite code required to create a new profile — recommended for any
# hosted deployment. Without it, anyone who can reach the app can sign up.
APP_PASSWORD=

# Any long random string. Used to encrypt the secrets profiles save in
# Settings (Gmail app password, API keys). Falls back to APP_PASSWORD.
# Changing it means saved secrets must be re-entered in Settings.
AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────────────
# Unset → embedded Postgres in ./data/pg (zero-config local use).
# Set to a free Neon connection string for persistent hosted storage.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Server-wide defaults (optional) ──────────────────────────────────
# Every profile normally connects its own Gmail and API keys on the
# Settings page. Values here act as fallback for profiles that haven't.

# Gmail / Google Workspace (sending + reply tracking). Requires 2-Step
# Verification, then create an app password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=

# Lead data providers (either one enables real lead search)
# https://apolloio.github.io/apollo-api-docs (Settings → Integrations → API)
APOLLO_API_KEY=
# https://hunter.io/api-keys
HUNTER_API_KEY=
